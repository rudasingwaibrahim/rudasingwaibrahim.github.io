 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Définition",
    "texte": "Pour tout $b > 0$, $\\log(b)$ est l'unique solution de l'équation $10^x =$ {{b}}. Ainsi $\\log(1\\,000) =$ {{3|trois}} car $10^3 = 1\\,000$, et $\\log(1) =$ {{0|zéro}}.",
    "expl": "Le logarithme décimal d'un nombre est l'exposant de la puissance de $10$ qui lui est égale."
   },
   {
    "titre": "Propriétés algébriques",
    "texte": "Le logarithme transforme un produit en {{somme}} : $\\log(a \\times b) = \\log(a) + \\log(b)$. Un quotient devient une {{différence}}, et dans $\\log(a^n) = n\\log(a)$, l'exposant $n$ sort en {{facteur}}. Enfin, $\\log\\left(\\dfrac{1}{b}\\right) = {{-\\log(b)|−log(b)|−log b}}$.",
    "expl": "Valable pour $a > 0$ et $b > 0$."
   },
   {
    "titre": "Démonstration : logarithme d'un quotient",
    "texte": "$\\log\\left(\\dfrac{a}{b}\\right) = \\log\\left(a \\times \\dfrac{1}{b}\\right) = \\log(a) + \\log\\left(\\dfrac{1}{b}\\right)$. On a utilisé la propriété du {{produit}}. Or $\\log(b) + \\log\\left(\\dfrac{1}{b}\\right) = \\log\\left(b \\times \\dfrac{1}{b}\\right) = \\log(1) = {{0|zéro}}$, donc $\\log\\left(\\dfrac{1}{b}\\right) = -\\log(b)$. Finalement, $\\log\\left(\\dfrac{a}{b}\\right) = \\log(a) {{-|−}} \\log(b)$.",
    "expl": "Tout découle de la formule du logarithme d'un produit, appliquée deux fois."
   },
   {
    "titre": "Sens de variation",
    "texte": "La fonction $\\log$ est strictement {{croissante}} sur $]0 ; +\\infty[$. Donc $\\log(x) < 0$ lorsque $0 < x <$ {{1|un}}, et $\\log(x) > 0$ lorsque $x >$ {{1|un}}. Le logarithme d'un nombre négatif n'est {{pas}} défini.",
    "expl": "Repère : la courbe passe par $(1 ; 0)$ et par $(10 ; 1)$."
   },
   {
    "titre": "Méthode : résoudre $a^x = b$",
    "texte": "Pour résoudre $3^x = 7$, on prend le {{logarithme|log}} des deux membres : $\\log(3^x) = \\log(7)$, soit $x \\times {{\\log(3)|log(3)|log 3}} = \\log(7)$, d'où $x = \\dfrac{\\log(7)}{\\log(3)} \\approx$ {{1,77|1,771}}.",
    "expl": "À la calculatrice : $\\log(7) \\approx 0{,}845$ et $\\log(3) \\approx 0{,}477$.",
    "chk": "abs(float(log(7,10)/log(3,10)) - 1.771) < 0.0005"
   },
   {
    "titre": "Inéquation : attention au signe",
    "texte": "Pour résoudre $0{,}9^n < 0{,}5$, on écrit $n\\log(0{,}9) < \\log(0{,}5)$. Or $\\log(0{,}9)$ est {{négatif}}, donc en divisant par ce nombre, le sens de l'inégalité {{change}} : $n > \\dfrac{\\log(0{,}5)}{\\log(0{,}9)} \\approx 6{,}58$. Le plus petit entier qui convient est $n =$ {{7|sept}}.",
    "expl": "$0{,}9 < 1$, donc $\\log(0{,}9) < 0$.",
    "chk": "abs(float(log(Rational(1,2),10)/log(Rational(9,10),10)) - 6.58) < 0.005"
   },

 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Proportion",
    "texte": "La proportion d'une sous-population d'effectif $n$ dans une population de {{référence|reference}} d'effectif $N$ est $p = \\dfrac{n}{N}$. Sur 480 élèves, 108 sont externes : $p =$ {{0,225|0.225}}, soit {{22,5|22.5}} %.",
    "expl": "Une proportion est un nombre compris entre $0$ et $1$ ; on la multiplie par $100$ pour l'exprimer en pourcentage."
   },
   {
    "titre": "Calculer un effectif",
    "texte": "Calculer $T$ % d'un effectif $N$ revient à calculer $\\dfrac{T}{100} \\times N$. Ainsi 15 % de 480 élèves représentent {{72}} élèves, et 18 % de 650 élèves en représentent {{117}}. De même, 12 % de 75 employés représentent {{9}} employés.",
    "expl": "$0{,}15 \\times 480 = 72$ et $0{,}18 \\times 650 = 117$."
   },
   {
    "titre": "Augmentation et diminution",
    "texte": "Augmenter une valeur de 8 % revient à la multiplier par {{1,08|1.08}}. La diminuer de 35 % revient à la multiplier par {{0,65|0.65}}. Ainsi un prix de 160 € diminué de 35 % devient {{104}} €.",
    "expl": "Augmenter de $T$ % : $\\times \\left(1 + \\dfrac{T}{100}\\right)$ ; diminuer de $T$ % : $\\times \\left(1 - \\dfrac{T}{100}\\right)$."
   },
   {
    "titre": "Taux d'évolution",
    "texte": "Si une valeur passe de $V_0$ à $V_1$, le taux d'évolution est $t = \\dfrac{V_1 - V_0}{V_0}$. Pour un passage de 50 à 65 : $t = \\dfrac{65 - 50}{50} =$ {{0,3|0.3}}, soit {{30}} %. Le taux est positif lorsque la valeur {{augmente}}.",
    "expl": "Un taux négatif correspond à une baisse."
   },
   {
    "titre": "Évolutions successives",
    "texte": "Le coefficient multiplicateur global est le {{produit}} des coefficients successifs. Pour +10 % puis −5 % : $1{,}10 \\times$ {{0,95|0.95}} $=$ {{1,045|1.045}}, soit une hausse de {{4,5|4.5}} %.",
    "expl": "Les pourcentages ne s'additionnent pas : on multiplie les coefficients."
   },

 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Définition par le cosinus",
    "texte": "Si $\\vec{u}$ et $\\vec{v}$ sont non nuls et si $\\theta$ est une mesure de l'angle entre eux, alors $\\vec{u} \\cdot \\vec{v}$ $= \\|\\vec{u}\\| \\times \\|\\vec{v}\\| \\times {{\\cos\\theta|cos θ|cosθ|cos(θ)}}$. Si l'un des deux vecteurs est {{nul}}, le produit scalaire vaut {{0}}. Le résultat est un {{nombre|réel|nombre réel|reel}}, et non un vecteur.",
    "expl": "Exemple : $\\|\\vec{u}\\| = 2$, $\\|\\vec{v}\\| = 5$, $\\theta = \\dfrac{\\pi}{4}$ donne $\\vec{u} \\cdot \\vec{v} = 10 \\times \\dfrac{\\sqrt{2}}{2} = 5\\sqrt{2}$."
   },
   {
    "titre": "Carré scalaire",
    "texte": "Avec $\\vec{v} = \\vec{u}$, l'angle est nul et $\\cos 0 = {{1}}$. Donc $\\vec{u} \\cdot \\vec{u}$ est égal au {{carré|carre}} de la norme de $\\vec{u}$ : $\\vec{u} \\cdot \\vec{u} = \\|\\vec{u}\\|^2$. En particulier, $\\overrightarrow{AB} \\cdot \\overrightarrow{AB} = {{AB^2|AB²}}$.",
    "expl": "On note aussi $\\vec{u}^2 = \\vec{u} \\cdot \\vec{u}$."
   },
   {
    "titre": "Symétrie et bilinéarité",
    "texte": "Pour tous vecteurs $\\vec{u}$, $\\vec{v}$, $\\vec{w}$ et tout réel $k$ : $\\vec{u} \\cdot \\vec{v}$ $= {{\\vec{v} \\cdot \\vec{u}|v·u|v.u|vu}}$ ; $\\vec{u} \\cdot (\\vec{v} + \\vec{w}) = \\vec{u} \\cdot \\vec{v} + {{\\vec{u} \\cdot \\vec{w}|u·w|u.w|uw}}$ ; $\\vec{u} \\cdot (k\\vec{v}) = {{k}}\\,(\\vec{u} \\cdot \\vec{v})$.",
    "expl": "On calcule donc avec le produit scalaire comme avec la multiplication des nombres."
   },
   {
    "titre": "Identités remarquables",
    "texte": "$(\\vec{u} + \\vec{v})^2 = \\vec{u}^2 + {{2}}\\,\\vec{u} \\cdot \\vec{v} + \\vec{v}^2$ ; $(\\vec{u} - \\vec{v})^2 = \\vec{u}^2 {{-}} 2\\,\\vec{u} \\cdot \\vec{v} + \\vec{v}^2$ ; $(\\vec{u} + \\vec{v}) \\cdot (\\vec{u} - \\vec{v}) = {{\\vec{u}^2 - \\vec{v}^2|u²-v²|u^2-v^2}}$.",
    "expl": "Avec $\\vec{u}^2 = \\|\\vec{u}\\|^2$, on peut calculer la norme d'une somme ou d'une différence."
   },
   {
    "titre": "Formule de polarisation",
    "texte": "Dans un triangle $ABC$ avec $AB = 7$, $AC = 5$ et $BC = 8$ : $\\overrightarrow{AB} \\cdot \\overrightarrow{AC} = \\dfrac{1}{2}(49 + 25 - {{64}}) = {{5}}$. Cette formule n'utilise que des {{longueurs|distances}}. Comme le résultat est positif, l'angle $\\widehat{BAC}$ est {{aigu}}.",
    "expl": "$\\dfrac{1}{2} \\times 10 = 5 > 0$.",
    "chk": "Rational(1, 2)*((7)**2 + (5)**2 - (8)**2) == 5"
   },

 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Asymptote horizontale",
    "texte": "Si $\\lim\\limits_{x\\to+\\infty}f(x)=\\ell$ (réel), on dit que la droite d’équation {{y=ℓ|y = ℓ|y=l}} est asymptote {{horizontale}} à la courbe de $f$ en {{+∞|+inf|plus l'infini}}.",
    "expl": "La courbe se rapproche de la droite horizontale quand $x$ devient grand."
   },
   {
    "titre": "Asymptote verticale",
    "texte": "Si $\\lim\\limits_{x\\to a}f(x)=+\\infty$ ou $-\\infty$ (éventuellement à droite ou à gauche), la droite d’équation {{x=a|x = a}} est asymptote {{verticale}} à la courbe. Pour $f(x)=\\dfrac{1}{x+4}$, c’est la droite $x=$ {{−4|-4}}.",
    "expl": "Une valeur interdite où le numérateur ne s’annule pas donne en général une asymptote verticale."
   },
   {
    "titre": "Limites usuelles en 0",
    "texte": "$\\lim\\limits_{x\\to0^+}\\dfrac{1}{x}=$ {{+∞|+inf}}, $\\lim\\limits_{x\\to0^-}\\dfrac{1}{x}=$ {{−∞|-∞|-inf}} et $\\lim\\limits_{x\\to0}\\dfrac{1}{x^2}=$ {{+∞|+inf}}.",
    "expl": "Le signe du dénominateur au voisinage de $0$ décide du signe de l’infini."
   },
   {
    "titre": "Polynôme à l’infini",
    "texte": "En $+\\infty$ ou en $-\\infty$, un polynôme a la même limite que son terme de plus haut {{degré|degre}}. Ainsi $\\lim\\limits_{x\\to-\\infty}(-2x^3+x)=\\lim\\limits_{x\\to-\\infty}(-2x^3)=$ {{+∞|+inf}} et $\\lim\\limits_{x\\to+\\infty}(x^4-10x^3)=$ {{+∞|+inf}}.",
    "expl": "On le justifie en factorisant par le terme de plus haut degré."
   },
   {
    "titre": "Quotient de polynômes",
    "texte": "Pour $f(x)=\\dfrac{5x^2+1}{2x^2-x}$, on factorise par {{x²|x^2}} en haut et en bas : $f(x)=\\dfrac{5+\\frac{1}{x^2}}{2-\\frac{1}{x}}$. En $+\\infty$, $f$ tend vers {{5/2|2,5}} et la courbe admet une asymptote {{horizontale}}.",
    "expl": "Même degré au numérateur et au dénominateur : la limite est le quotient des coefficients dominants."
   },
   {

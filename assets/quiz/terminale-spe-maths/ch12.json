 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Définition",
    "texte": "Pour tout réel $x>0$, l’équation $\\mathrm{e}^y=x$ a une unique solution, notée {{ln x|ln(x)|lnx}}. La fonction $\\ln$ est la fonction {{réciproque|reciproque}} de la fonction exponentielle. Ainsi $\\ln1=$ {{0}} et $\\ln\\mathrm{e}=1$.",
    "expl": "Pour tout $x>0$, $\\mathrm{e}^{\\ln x}=x$ ; pour tout réel $x$, $\\ln(\\mathrm{e}^x)=x$."
   },
   {
    "titre": "Relation fonctionnelle",
    "texte": "Pour tous réels $a>0$ et $b>0$ : $\\ln(ab)=$ {{ln a+ln b|ln(a)+ln(b)|lna+lnb}}. On en déduit $\\ln\\dfrac{1}{a}=$ {{−ln a|-ln a|-ln(a)}} et $\\ln\\dfrac{a}{b}=$ {{ln a−ln b|ln a-ln b|ln(a)-ln(b)}}.",
    "expl": "Démonstration : $\\mathrm{e}^{\\ln a+\\ln b}=\\mathrm{e}^{\\ln a}\\mathrm{e}^{\\ln b}=ab$."
   },
   {
    "titre": "Puissances et racines",
    "texte": "Pour tout $a>0$ et tout entier relatif $n$ : $\\ln(a^n)=$ {{n ln a|nln a|n×ln a|n ln(a)}}. De plus $\\ln\\sqrt{a}=$ {{(1/2)ln a|1/2 ln a|ln(a)/2|ln a/2}}. Exemple : $\\ln16=$ {{4ln2|4 ln 2|4ln(2)}}.",
    "expl": "$16=2^4$."
   },
   {
    "titre": "Équations",
    "texte": "Pour $a>0$ et $b>0$ : $\\ln a=\\ln b\\iff a=$ {{b}}. Pour tout réel $k$ : $\\ln x=k\\iff x=$ {{e^k|eᵏ|exp(k)}}. Et $\\mathrm{e}^x=k$ (avec $k>0$) $\\iff x=$ {{ln k|ln(k)}}.",
    "expl": "On n’oublie pas l’ensemble de définition des expressions contenant $\\ln$."
   },
   {
    "titre": "Inéquations",
    "texte": "La fonction $\\ln$ est strictement {{croissante}} sur $]0\\,;+\\infty[$ : pour $a,b>0$, $\\ln a<\\ln b\\iff a$ {{<}} $b$. Ainsi $\\ln x<0\\iff0<x<$ {{1}}.",
    "expl": "Ce résultat découle de la stricte croissance de l’exponentielle."
   },
   {
    "titre": "Seuil d’une suite géométrique",
    "texte": "On cherche le plus petit $n$ tel que $1{,}05^n\\geqslant2$. On applique $\\ln$, qui est croissante : $n\\ln1{,}05\\geqslant\\ln2$. Comme $\\ln1{,}05>0$, $n\\geqslant\\dfrac{\\ln2}{\\ln1{,}05}\\approx14{,}2$. Donc $n=$ {{15}}. Si la raison était $0{,}95$, on aurait $\\ln0{,}95$ {{<0|négatif|negatif}} et il faudrait changer le {{sens}} de l’inégalité.",
    "expl": "Diviser par un nombre négatif change le sens d’une inégalité."
   },
   {
    "titre": "Simplifications",
    "texte": "$\\ln(\\mathrm{e}^3)=$ {{3}} ; $\\mathrm{e}^{\\ln4}=$ {{4}} ; $\\ln\\dfrac{1}{\\mathrm{e}}=$ {{−1|-1}} ; $\\mathrm{e}^{-\\ln2}=$ {{1/2|0,5}}.",
    "expl": "$\\mathrm{e}^{-\\ln2}=\\dfrac{1}{\\mathrm{e}^{\\ln2}}=\\dfrac{1}{2}$."
   },
   {
    "titre": "Algorithme de Briggs",
    "texte": "Pour calculer $\\ln a$ ($a>0$), Briggs extrait des racines carrées successives : $a^{1/2^n}$ se rapproche de {{1}}. Pour $x$ proche de $1$, $\\ln x\\approx x-1$. Comme $\\ln\\left(a^{1/2^n}\\right)=\\dfrac{\\ln a}{2^n}$, on obtient $\\ln a\\approx$ {{2^n(a^(1/2^n)−1)|2^n(a^(1/2^n)-1)}}. L’approximation $\\ln x\\approx x-1$ vient de la {{tangente}} en $1$ à la courbe de $\\ln$.",
    "expl": "La tangente en $1$ à la courbe de $\\ln$ a pour équation $y=x-1$."
   }
  ]
 },

 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Dérivée de ln",
    "texte": "La fonction $\\ln$ est dérivable sur $]0\\,;+\\infty[$ et $\\ln'(x)=$ {{1/x}}. Comme $\\dfrac{1}{x}>0$, $\\ln$ est strictement {{croissante}}. Démonstration : on dérive $\\mathrm{e}^{\\ln x}=x$, ce qui donne $\\ln'(x)\\times\\mathrm{e}^{\\ln x}=$ {{1}}.",
    "expl": "Puis $\\ln'(x)\\times x=1$."
   },
   {
    "titre": "Limites aux bornes",
    "texte": "$\\lim\\limits_{x\\to0^+}\\ln x=$ {{−∞|-∞|-inf}} et $\\lim\\limits_{x\\to+\\infty}\\ln x=$ {{+∞|+inf}}. La courbe de $\\ln$ admet l’axe des ordonnées comme asymptote {{verticale}}.",
    "expl": "Elle n’a pas d’asymptote horizontale."
   },
   {
    "titre": "Croissances comparées",
    "texte": "Pour tout entier $n\\geqslant1$ : $\\lim\\limits_{x\\to+\\infty}\\dfrac{\\ln x}{x^n}=$ {{0}} et $\\lim\\limits_{x\\to0^+}x^n\\ln x=$ {{0}}. Les puissances de $x$ l’emportent sur le {{logarithme}}.",
    "expl": "Pour $n=1$, la limite en $0$ de $x\\ln x$ se démontre avec $X=\\ln x$ : $x\\ln x=X\\mathrm{e}^X$."
   },
   {
    "titre": "Dérivée de ln u",
    "texte": "Si $u$ est dérivable et strictement {{positive}} sur $I$, alors $\\ln u$ est dérivable sur $I$ et $(\\ln u)'=$ {{u'/u}}. Pour $f(x)=\\ln(x^2+3)$ : $f'(x)=$ {{2x/(x²+3)|2x/(x^2+3)}}.",
    "expl": "$\\ln u$ et $u$ ont le même sens de variation."
   },
   {
    "titre": "Courbes de ln et exp",
    "texte": "Les courbes de $\\ln$ et $\\exp$ sont symétriques par rapport à la droite d’équation {{y=x|y = x}}. La courbe de $\\ln$ passe par les points $(1\\,;0)$ et $(\\mathrm{e}\\,;$ {{1}}$)$. La fonction $\\ln$ est {{concave}}.",
    "expl": "La courbe de $\\exp$ passe par $(0\\,;1)$ et $(1\\,;\\mathrm{e})$."
   },
   {
    "titre": "Étude de x − ln x",
    "texte": "$f(x)=x-\\ln x$ sur $]0\\,;+\\infty[$ : $f'(x)=1-\\dfrac{1}{x}=\\dfrac{x-1}{x}$. $f$ est décroissante sur $]0\\,;1]$ et {{croissante}} sur $[1\\,;+\\infty[$. Son minimum est $f(1)=$ {{1}}. On en déduit que, pour tout $x>0$, $\\ln x$ {{<|est inférieur à|inférieur à}} $x$.",
    "expl": "$f(x)\\geqslant1>0$, donc $\\ln x<x$."
   },
   {
    "titre": "Limite de x ln x en 0",
    "texte": "On pose $X=\\ln x$ : quand $x\\to0^+$, $X\\to$ {{−∞|-∞|-inf}}. Alors $x\\ln x=X\\mathrm{e}^{X}$, et par croissance comparée $\\lim\\limits_{X\\to-\\infty}X\\mathrm{e}^X=$ {{0}}. Donc $\\lim\\limits_{x\\to0^+}x\\ln x=$ {{0}}.",
    "expl": "C’est une démonstration exigible."
   },
   {
    "titre": "Inégalité de concavité",
    "texte": "La tangente à la courbe de $\\ln$ au point d’abscisse $1$ a pour équation $y=$ {{x−1|x-1}}. Comme $\\ln$ est {{concave}}, sa courbe est {{en dessous|au-dessous}} de cette tangente : $\\ln x\\leqslant x-1$ pour tout $x>0$.",
    "expl": "Égalité seulement pour $x=1$."
   }
  ]
 },

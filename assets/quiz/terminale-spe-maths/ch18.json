 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Intégrale et aire",
    "texte": "Si $f$ est continue et {{positive}} sur $[a\\,;b]$, $\\displaystyle\\int_a^bf(x)\\,\\mathrm{d}x$ est l’{{aire}} du domaine compris entre la courbe, l’axe des abscisses et les droites $x=a$ et $x=b$, exprimée en unités d’{{aire}}.",
    "expl": "La variable $x$ est « muette » : $\\displaystyle\\int_a^bf(x)\\,\\mathrm{d}x=\\int_a^bf(t)\\,\\mathrm{d}t$."
   },
   {
    "titre": "Théorème fondamental",
    "texte": "Si $f$ est continue sur un intervalle contenant $a$, la fonction $F_a:x\\mapsto\\displaystyle\\int_a^xf(t)\\,\\mathrm{d}t$ est la {{primitive}} de $f$ qui s’annule en {{a}}. Pour toute primitive $F$ de $f$ : $\\displaystyle\\int_a^bf(x)\\,\\mathrm{d}x=$ {{F(b)−F(a)|F(b)-F(a)}}.",
    "expl": "On note aussi $[F(x)]_a^b=F(b)-F(a)$."
   },
   {
    "titre": "Linéarité et Chasles",
    "texte": "Pour tous réels $\\alpha$, $\\beta$ : $\\displaystyle\\int_a^b(\\alpha f+\\beta g)=\\alpha\\int_a^bf+\\beta\\int_a^bg$ ; c’est la {{linéarité|linearite}} de l’intégrale. Relation de {{Chasles}} : $\\displaystyle\\int_a^bf+\\int_b^cf=\\int_a^cf$. Enfin $\\displaystyle\\int_b^af$ est l’{{opposé|oppose|opposée}} de $\\displaystyle\\int_a^bf$.",
    "expl": "Ces propriétés permettent de découper les calculs."
   },
   {
    "titre": "Positivité",
    "texte": "Si $a\\leqslant b$ et $f\\geqslant0$ sur $[a\\,;b]$, alors $\\displaystyle\\int_a^bf\\geqslant$ {{0}}. Si $f\\leqslant g$ sur $[a\\,;b]$, alors $\\displaystyle\\int_a^bf$ {{≤|<=|inférieur ou égal à}} $\\displaystyle\\int_a^bg$. Si $m\\leqslant f\\leqslant M$ sur $[a\\,;b]$, alors $m(b-a)\\leqslant\\displaystyle\\int_a^bf\\leqslant$ {{M(b−a)|M(b-a)}}.",
    "expl": "Attention : il faut $a\\leqslant b$."
   },
   {
    "titre": "Valeur moyenne",
    "texte": "La valeur moyenne de $f$ sur $[a\\,;b]$ ($a<b$) est $\\mu=\\dfrac{1}{b-a}\\displaystyle\\int_a^bf(x)\\,\\mathrm{d}x$. Pour $f(x)=2x$ sur $[0\\,;3]$ : $\\displaystyle\\int_0^32x\\,\\mathrm{d}x=$ {{9}}, donc $\\mu=$ {{3}}. Graphiquement, $\\mu$ est la hauteur du {{rectangle}} de base $[a\\,;b]$ ayant la même aire que le domaine sous la courbe.",
    "expl": "$\\dfrac{1}{3}[x^2]_0^3=\\dfrac{9}{3}$."
   },
   {
    "titre": "Calculer une intégrale",
    "texte": "Pour calculer $\\displaystyle\\int_1^2(3x^2+1)\\,\\mathrm{d}x$, on cherche une primitive : $F(x)=$ {{x^3+x|x³+x}}. On obtient $F(2)-F(1)=10-$ {{2}} $=$ {{8}}.",
    "expl": "$F(2)=8+2=10$ et $F(1)=1+1=2$."
   },
   {
    "titre": "Méthode des rectangles",
    "texte": "Pour approcher $\\displaystyle\\int_a^bf$, on découpe $[a\\,;b]$ en $n$ intervalles de longueur $h=$ {{(b−a)/n|(b-a)/n}} et on additionne les aires de {{rectangles}}. Si $f$ est croissante, les rectangles à gauche donnent une valeur approchée par {{défaut|defaut}}.",
    "expl": "Les rectangles à droite donnent alors une valeur par excès."
   },
   {
    "titre": "Aire entre deux courbes",
    "texte": "Si $f\\geqslant g$ sur $[a\\,;b]$, l’aire du domaine compris entre les deux courbes et les droites $x=a$, $x=b$ est $\\displaystyle\\int_a^b$ {{(f−g)|(f-g)|f−g|f-g}}. Pour $f(x)=x$ et $g(x)=x^2$ sur $[0\\,;1]$, on obtient {{1/6}}. On vérifie d’abord que $f\\geqslant g$, car $x\\geqslant x^2$ sur $[0\\,;1]$ : c’est la {{position}} relative des courbes.",
    "expl": "$\\dfrac{1}{2}-\\dfrac{1}{3}=\\dfrac{1}{6}$."
   }
  ]
 },

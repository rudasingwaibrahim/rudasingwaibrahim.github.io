 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Limites de l’exponentielle",
    "texte": "$\\lim\\limits_{x\\to+\\infty}\\mathrm{e}^x=$ {{+∞|+inf}} et $\\lim\\limits_{x\\to-\\infty}\\mathrm{e}^x=$ {{0}}. La courbe de $\\exp$ admet donc l’asymptote {{horizontale}} d’équation $y=0$ en $-\\infty$.",
    "expl": "La démonstration de la limite en $+\\infty$ utilise l’inégalité $\\mathrm{e}^x\\geqslant x+1$ et le théorème de comparaison."
   },
   {
    "titre": "Croissances comparées",
    "texte": "Pour tout entier naturel $n$ : $\\lim\\limits_{x\\to+\\infty}\\dfrac{\\mathrm{e}^x}{x^n}=$ {{+∞|+inf}} et $\\lim\\limits_{x\\to-\\infty}x^n\\mathrm{e}^x=$ {{0}}. On dit que l’{{exponentielle}} l’emporte sur les puissances de $x$.",
    "expl": "Ces résultats servent à lever les formes indéterminées « $\\dfrac{\\infty}{\\infty}$ » et « $0\\times\\infty$ » mêlant puissances et exponentielle."
   },
   {
    "titre": "Théorème de comparaison",
    "texte": "Si $f(x)\\geqslant g(x)$ pour $x$ assez grand et si $\\lim\\limits_{x\\to+\\infty}g(x)=+\\infty$, alors $\\lim\\limits_{x\\to+\\infty}f(x)=$ {{+∞|+inf}}. Si $f(x)\\leqslant h(x)$ et $\\lim\\limits_{x\\to+\\infty}h(x)=-\\infty$, alors $f(x)\\to$ {{−∞|-∞|-inf}}. On {{minore|minore f}} pour obtenir $+\\infty$.",
    "expl": "Il suffit d’une seule fonction de comparaison, placée du bon côté."
   },
   {
    "titre": "Théorème des gendarmes",
    "texte": "Si $g(x)\\leqslant f(x)\\leqslant h(x)$ pour $x$ assez grand et si $g$ et $h$ ont la même limite {{finie}} $\\ell$ en $+\\infty$, alors $f(x)\\to$ {{ℓ|l}}. Exemple : $\\dfrac{\\sin x}{x}\\to$ {{0}} en $+\\infty$.",
    "expl": "Pour $x>0$, $-\\dfrac{1}{x}\\leqslant\\dfrac{\\sin x}{x}\\leqslant\\dfrac{1}{x}$."
   },
   {
    "titre": "Limite d’une composée",
    "texte": "Pour calculer $\\lim\\limits_{x\\to+\\infty}\\mathrm{e}^{-3x+1}$, on pose $X=-3x+1$. Quand $x\\to+\\infty$, $X\\to$ {{−∞|-∞|-inf}}. Or $\\lim\\limits_{X\\to-\\infty}\\mathrm{e}^X=$ {{0}}, donc la limite cherchée est {{0}}.",
    "expl": "Composition : si $u(x)\\to b$ et $v(X)\\to c$ quand $X\\to b$, alors $v(u(x))\\to c$."
   },
   {
    "titre": "Factoriser par le terme prépondérant",
    "texte": "Pour $f(x)=\\mathrm{e}^x-x^2$ en $+\\infty$, on a une forme « {{∞−∞|∞-∞|inf-inf}} ». On factorise par {{e^x|ex|eˣ|exp(x)}} : $f(x)=\\mathrm{e}^x\\left(1-\\dfrac{x^2}{\\mathrm{e}^x}\\right)$. Comme $\\dfrac{x^2}{\\mathrm{e}^x}\\to0$, $f(x)\\to$ {{+∞|+inf}}.",

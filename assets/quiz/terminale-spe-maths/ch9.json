 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Théorèmes de comparaison",
    "texte": "Si $u_n\\geqslant v_n$ à partir d’un certain rang et si $\\lim v_n=+\\infty$, alors $\\lim u_n=$ {{+∞|+inf}}. Si $u_n\\leqslant w_n$ à partir d’un certain rang et si $\\lim w_n=-\\infty$, alors $\\lim u_n=$ {{−∞|-∞|-inf}}. On dit que $(u_n)$ est {{minorée|minoree}} par une suite qui tend vers $+\\infty$ dans le premier cas.",
    "expl": "Exemple : $n^2+(-1)^n\\geqslant n^2-1\\to+\\infty$."
   },
   {
    "titre": "Théorème des gendarmes",
    "texte": "Si $v_n\\leqslant u_n\\leqslant w_n$ à partir d’un certain rang et si $(v_n)$ et $(w_n)$ convergent vers la même limite $\\ell$, alors $(u_n)$ {{converge}} vers {{ℓ|l}}. Exemple : $\\dfrac{\\sin n}{n}\\to$ {{0}}.",
    "expl": "Le théorème est aussi appelé théorème d’encadrement."
   },
   {
    "titre": "Convergence monotone",
    "texte": "Toute suite croissante et {{majorée|majoree}} converge. Toute suite décroissante et {{minorée|minoree}} converge. Toute suite croissante non majorée tend vers {{+∞|+inf}}.",
    "expl": "Ce théorème assure l’existence de la limite, sans en donner la valeur."
   },
   {
    "titre": "Limite de q puissance n",
    "texte": "Si $q>1$, $\\lim q^n=$ {{+∞|+inf}}. Si $-1<q<1$, $\\lim q^n=$ {{0}}. Si $q=1$, la suite est constante. Si $q\\leqslant-1$, la suite n’a {{pas}} de limite.",
    "expl": "La démonstration pour $q>1$ repose sur l’inégalité de Bernoulli."
   },
   {
    "titre": "Somme géométrique",
    "texte": "Pour $q\\neq1$ : $1+q+q^2+\\dots+q^n=$ {{(1−q^(n+1))/(1−q)|(1-q^(n+1))/(1-q)}}. Si $-1<q<1$, cette somme tend vers {{1/(1−q)|1/(1-q)}} quand $n\\to+\\infty$. Pour $q=0{,}2$, la limite vaut {{1,25|5/4}}.",
    "expl": "$\\dfrac{1}{1-0{,}2}=\\dfrac{1}{0{,}8}=1{,}25$."
   },
   {
    "titre": "Suite bornée",
    "texte": "$(u_n)$ est majorée s’il existe un réel $M$ tel que, pour tout $n$, $u_n\\leqslant$ {{M}}. Elle est minorée s’il existe $m$ tel que $u_n\\geqslant m$. Elle est {{bornée|bornee}} si elle est à la fois majorée et minorée. Toute suite convergente est {{bornée|bornee}}.",
    "expl": "La réciproque est fausse : $((-1)^n)$ est bornée mais ne converge pas."
   },
   {
    "titre": "Suite arithmético-géométrique",
    "texte": "$u_{n+1}=0{,}6u_n+2$. Le point fixe vérifie $\\ell=0{,}6\\ell+2$, soit $\\ell=$ {{5}}. La suite $v_n=u_n-5$ est géométrique de raison {{0,6}}, donc $v_n\\to$ {{0}} et $u_n\\to5$.",
    "expl": "$v_{n+1}=0{,}6u_n+2-5=0{,}6(u_n-5)$."
   },
   {
    "titre": "Recherche de seuil",
    "texte": "$u_n=1\\,000\\times0{,}9^n$. Pour trouver le plus petit $n$ tel que $u_n<100$, on initialise $n$ à $0$ et $u$ à $1\\,000$, puis {{tant que}} $u\\geqslant100$, on multiplie $u$ par {{0,9}} et on ajoute $1$ à $n$. On obtient $n=$ {{22}}.",
    "expl": "$0{,}9^{21}\\approx0{,}109$ et $0{,}9^{22}\\approx0{,}098$."
   }
  ]
 },

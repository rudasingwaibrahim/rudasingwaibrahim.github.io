 "trous": {
  "servir": 4,
  "textes": [
   {
    "titre": "Dérivées",
    "texte": "Les fonctions $\\cos$ et $\\sin$ sont dérivables sur $\\mathbb{R}$ : $\\cos'=$ {{−sin|-sin|-sin x|−sin x}} et $\\sin'=$ {{cos|cos x}}. Pour $a$, $b$ réels, la dérivée de $x\\mapsto\\cos(ax+b)$ est $x\\mapsto$ {{−a sin(ax+b)|-a sin(ax+b)|-asin(ax+b)}}.",
    "expl": "Et celle de $x\\mapsto\\sin(ax+b)$ est $x\\mapsto a\\cos(ax+b)$."
   },
   {
    "titre": "Parité et périodicité",
    "texte": "Pour tout réel $x$ : $\\cos(-x)=\\cos x$, donc $\\cos$ est {{paire}} ; $\\sin(-x)=-\\sin x$, donc $\\sin$ est {{impaire}}. Les deux fonctions sont périodiques de période {{2π|2pi|2 π}}.",
    "expl": "On étudie donc ces fonctions sur $[0\\,;\\pi]$, puis on complète par symétrie et translation."
   },
   {
    "titre": "Variations sur [0 ; π]",
    "texte": "Sur $[0\\,;\\pi]$, $\\cos$ est {{décroissante|decroissante}} de $1$ à {{−1|-1}}. La fonction $\\sin$ est croissante sur $\\left[0\\,;\\dfrac{\\pi}{2}\\right]$ puis décroissante ; son maximum vaut {{1}}.",
    "expl": "Ces variations se lisent sur le cercle trigonométrique."
   },
   {
    "titre": "Équation cos x = a",
    "texte": "Pour $a\\in[-1\\,;1]$, l’équation $\\cos x=a$ a sur $]-\\pi\\,;\\pi]$ deux solutions opposées $\\alpha$ et {{−α|-α|-alpha}} (une seule si $a=1$ ou $a=-1$). Pour $\\cos x=\\dfrac{\\sqrt{3}}{2}$, on trouve $x=\\dfrac{\\pi}{6}$ ou $x=$ {{−π/6|-π/6|-pi/6}}. Si $a>1$, il n’y a {{aucune}} solution.",
    "expl": "Sur $\\mathbb{R}$, on ajoute les multiples de $2\\pi$."
   },
   {
    "titre": "Inéquation",
    "texte": "Sur $[-\\pi\\,;\\pi]$, $\\cos x\\leqslant\\dfrac{\\sqrt{2}}{2}$ équivaut à $x\\in\\left[-\\pi\\,;-\\dfrac{\\pi}{4}\\right]\\cup\\left[\\dfrac{\\pi}{4}\\,;\\pi\\right]$. On résout d’abord l’{{équation|equation}} $\\cos x=\\dfrac{\\sqrt{2}}{2}$, de solutions {{π/4|pi/4}} et $-\\dfrac{\\pi}{4}$, puis on lit sur le {{cercle}} les points d’abscisse inférieure.",
    "expl": "Un schéma du cercle évite les erreurs."
   },
   {
    "titre": "Étude d’une fonction",
    "texte": "$f(x)=2\\sin x+x$ sur $[0\\,;\\pi]$ : $f'(x)=$ {{2cos x+1|2cos(x)+1|1+2cos x}}. $f'(x)=0\\iff\\cos x=-\\dfrac{1}{2}\\iff x=$ {{2π/3|2pi/3}}. $f$ est croissante sur $\\left[0\\,;\\dfrac{2\\pi}{3}\\right]$ puis {{décroissante|decroissante}}.",
    "expl": "Maximum en $\\dfrac{2\\pi}{3}$ : $f\\left(\\dfrac{2\\pi}{3}\\right)=\\sqrt{3}+\\dfrac{2\\pi}{3}$."
   },
   {
    "titre": "Limite remarquable",
    "texte": "$\\lim_{x\\to0}\\dfrac{\\sin x}{x}$ est le nombre dérivé de $\\sin$ en {{0}}, égal à $\\cos0=$ {{1}}. De même $\\lim_{x\\to0}\\dfrac{\\cos x-1}{x}=$ {{0}}.",
    "expl": "On reconnaît des taux d’accroissement."
   },
   {
    "titre": "Valeurs remarquables",
    "texte": "$\\cos0=1$, $\\cos\\dfrac{\\pi}{2}=$ {{0}}, $\\sin\\dfrac{\\pi}{6}=$ {{1/2|0,5}}, $\\cos\\pi=$ {{−1|-1}} et $\\sin\\dfrac{\\pi}{3}=$ {{√3/2|sqrt(3)/2}}.",
    "expl": "Ces valeurs se retrouvent sur le cercle trigonométrique."
   }
  ]
 },

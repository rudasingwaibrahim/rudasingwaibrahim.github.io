---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- include init.html %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
  {%- assign _skip = false -%}
  {%- if p.sitemap == false or p.noindex or p.canonical_url -%}{%- assign _skip = true -%}{%- endif -%}
  {%- unless p.url contains "/" -%}{%- assign _skip = true -%}{%- endunless -%}
  {%- if p.url contains ".json" or p.url contains ".xml" or p.url contains ".txt" or p.url contains "404" -%}{%- assign _skip = true -%}{%- endif -%}
  {%- if p.url contains "/chapitre" -%}{%- include doc-count.html p=p -%}{%- if _doc_count == 0 -%}{%- assign _skip = true -%}{%- endif -%}{%- endif -%}
  {%- unless _skip %}
  <url><loc>{{ site.url }}{{ p.url | replace: "index.html", "" }}</loc>{% if p.url == "/" %}<priority>1.0</priority>{% elsif p.classe %}<priority>0.9</priority>{% endif %}</url>
  {%- endunless -%}
{%- endfor %}
{%- for j in site.data.arcade.jeux %}
  <url><loc>{{ site.url }}/sigma-arcade/{{ j.slug }}/</loc></url>
{%- endfor %}
</urlset>
